<header class="page-header">
  <div class="header-left">
    <h1>🚀 TaskFlow</h1>
  </div>

  <div class="header-right">
    <% if (isLoggedIn) { %>
      <a href="/dashboard#pendingInvitesSection" class="btn-secondary header-notification">
        🔔
        <% if (typeof pendingInvitesCount !== 'undefined' && pendingInvitesCount > 0) { %>
          <span class="notification-badge"><%= pendingInvitesCount %></span>
        <% } %>
      </a>
      <a href="/dashboard" class="btn-secondary">Dashboard</a>
      <a href="/project/create" class="btn-secondary">+ Create Project</a>
      <a href="/task/create" class="btn-primary">+ Create Task</a>
      <button id="logoutBtn" class="btn-secondary">Logout</button>
    <% } else { %>
      <a href="/login" class="btn-secondary">Login</a>
      <a href="/register" class="btn-secondary">Register</a>
    <% } %>
  </div>
</header>