<div class="page">
  <div class="page-toolbar">
    <h2>Project List</h2>
    <a href="/project/create" class="btn-primary">+ Create Project</a>
  </div>
    <% if (!projectList || projectList.length === 0) { %>
    <section class="empty-state-card">
      <h3>Không có dự án nào</h3>
      <p>Hãy tạo dự án mới để bắt đầu quản lý công việc.</p>
      <a href="/project/create" class="btn-primary">Tạo dự án</a>
    </section>
  <% } else { %>
    <section class="project-list-grid">
      <% projectList.forEach(project => { %>
        <div class="project-list-card">
          <h3><%= project.name %></h3>
          <p><%= project.description || 'Mô tả chưa có' %></p>
          <div class="project-list-meta">
            <p>Owner: <%= project.ownerName || 'Chưa xác định' %></p>
            <a href="/dashboard" class="btn-secondary">View Project</a>
          </div>
        </div>
      <% }) %>
    </section>
  <% } %>
</div>
</div>