<div class="page">
  <p class="page-subtitle">Create a new task for your project</p>

  <section class="form-page">
    <div class="form-card">
      <div class="form-card-header">
        <div>
          <p class="project-label">Task Management</p>
          <h2>Create New Task</h2>
        </div>
        <a href="/dashboard" class="back-link">← Back to dashboard</a>
      </div>

      <form class="task-form" id="createTaskForm">
        <div class="form-grid">
          <div class="form-group">
            <label for="title">Task Title</label>
            <input type="text" id="title" name="title" placeholder="Enter task title" required>
          </div>

          <div class="form-group">
            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" required>
              <% projects.forEach(project => { %>
                <option value="<%= project._id %>"><%= project.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group form-group-full">
            <label for="description">Description</label>
            <textarea id="description" name="description" placeholder="Enter task description" required></textarea>
          </div>

          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status" required>
            </select>
          </div>

          <div class="form-group">
            <label for="priority">Priority</label>
            <select id="priority" name="priority" required>
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
          </div>

          <div class="form-group">
            <label for="assigneeId">Assignee</label>
            <select id="assigneeId" name="assigneeId" required>
              <% users.forEach(user => { %>
                <option value="<%= user.id %>"><%= user.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="deadline">Deadline</label>
            <input type="date" id="deadline" name="deadline" required>
          </div>
        </div>

        <p id="taskMessage" class="form-message"></p>

        <div class="form-actions">
          <a href="/dashboard" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary">Create Task</button>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
  const createTaskForm = document.getElementById("createTaskForm");
  const taskMessage = document.getElementById("taskMessage");
  const statusSelect = document.getElementById("status");
  const projectSelect = document.getElementById("projectId");
  const projectWorkflows = <%- JSON.stringify(projects.map(project => ({ id: project._id, workflow: project.workflow || [{ key: "todo", label: "To Do" }, { key: "in_progress", label: "In Progress" }, { key: "done", label: "Done" }] }))) %>;

  const populateStatusOptions = (projectId) => {
    const project = projectWorkflows.find(item => item.id === projectId);
    const workflow = project ? project.workflow : [{ key: "todo", label: "To Do" }, { key: "in_progress", label: "In Progress" }, { key: "done", label: "Done" }];
    statusSelect.innerHTML = workflow
      .map(column => `<option value="${column.key}">${column.label}</option>`)
      .join("");
  };

  projectSelect.addEventListener("change", event => {
    populateStatusOptions(event.target.value);
  });

  populateStatusOptions(projectSelect.value);

  createTaskForm.addEventListener("submit", async event => {
    event.preventDefault();

    const formData = {
      title: document.getElementById("title").value.trim(),
      projectId: document.getElementById("projectId").value,
      description: document.getElementById("description").value.trim(),
      status: document.getElementById("status").value,
      priority: document.getElementById("priority").value,
      assigneeId: document.getElementById("assigneeId").value,
      deadline: document.getElementById("deadline").value
    };

    taskMessage.textContent = "Processing...";
    taskMessage.className = "form-message";

    try {
      const response = await fetch("/api/tasks", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(formData)
      });

      const data = await response.json();

      if (!response.ok) {
        taskMessage.textContent = data.message || "Create task failed";
        taskMessage.className = "form-message error-message";
        return;
      }

      taskMessage.textContent = data.message || "Task created successfully";
      taskMessage.className = "form-message success-message";
      setTimeout(() => {
        window.location.href = "/dashboard";
      }, 600);
    } catch (error) {
      taskMessage.textContent = "Cannot connect to server";
      taskMessage.className = "form-message error-message";
    }
  });

  const queryStatus = new URLSearchParams(window.location.search).get('status');
  if (queryStatus) {
    const statusSelect = document.getElementById('status');
    if (statusSelect && statusSelect.querySelector(`option[value="${queryStatus}"]`)) {
      statusSelect.value = queryStatus;
    }
  }
</script>