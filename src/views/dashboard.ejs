<% function getAge(dob) { 
  const birth = new Date(dob);
  const today = new Date();
  let age = today.getFullYear() - birth.getFullYear();
  const monthDiff = today.getMonth() - birth.getMonth();
  if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) { age--; }
  return age; [cite: 1, 3]
} %>

<div class="page">
  <p class="page-subtitle"><%= landingMode ? "Welcome to TaskFlow. Log in or register to unlock your full dashboard experience." : "Project Dashboard + Kanban Board" %></p> [cite: 9]

  <% if (landingMode) { %>
    <section class="landing-preview">
      <div class="landing-card">
        <h2>Discover TaskFlow</h2>
        <div class="landing-features">
          <div class="feature-item"><h3>Kanban board</h3><p>See progress across todo, in progress, and done.</p></div>
          <div class="feature-item"><h3>Project overview</h3><p>Track active projects at a glance.</p></div> [cite: 11]
        </div>
        <div class="landing-actions">
          <a href="/login" class="btn-primary">Login</a>
          <a href="/register" class="btn-secondary">Register</a> [cite: 12]
        </div>
      </div>
    </section>
  <% } else { %>
    <section class="project-overview">
      <div class="project-info-card">
        <% if (currentProject) { %>
          <div class="project-main-info">
            <div><p class="project-label">Current Project</p><h2><%= currentProject.name %></h2></div> [cite: 13]
          </div>
          <p><%= currentProject.description %></p>
        <% } else { %>
          <h2>No Project Selected</h2> [cite: 14]
        <% } %>
      </div>
    </section>

    <section class="stats">
      <div class="stat-card"><h3>Total Tasks</h3><p><%= totalTasks %></p></div> [cite: 15]
      <div class="stat-card"><h3>Overdue</h3><p><%= overdueTasks %></p></div>
      <div class="stat-card"><h3>In Progress</h3><p><%= inProgressTasks %></p></div>
      <div class="stat-card"><h3>Done</h3><p><%= doneTasks %></p></div> [cite: 16]
    </section>

    <section class="board">
      <% ["todo", "in_progress", "done"].forEach(status => { %>
        <div class="column drop-zone" data-status="<%= status %>" ondrop="dropTaskWithUpdate(event)" ondragover="event.preventDefault()">
          <h2><%= status.replace('_', ' ').toUpperCase() %></h2>
          <% activeTasks.filter(t => t.status === status).forEach(task => { %>
            <div class="task-card" id="task-<%= task._id %>" draggable="true" ondragstart="dragTask(event)">
              <h4><%= task.title %></h4>
              <p><%= task.description %></p>
              <a href="/task/<%= task._id %>">View detail</a> [cite: 17, 18]
            </div>
          <% }) %>
        </div>
      <% }) %>
    </section>

    <section class="team">
      <h2>👥 Project Members</h2>
      <div class="team-list">
        <% currentProjectMembers.forEach(member => { %>
          <div class="team-card <%= member.role === 'Owner' ? 'leader-card' : '' %>"> [cite: 25]
            <h3><%= member.name %></h3>
            <p>Age: <%= getAge(member.dob) %></p> [cite: 26]
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<script>
  function dragTask(event) { event.dataTransfer.setData("text/plain", event.currentTarget.id); } [cite: 5]
  async function dropTaskWithUpdate(event) {
    event.preventDefault();
    const taskId = event.dataTransfer.getData("text/plain");
    const taskCard = document.getElementById(taskId);
    let dropZone = event.target.closest(".drop-zone"); [cite: 28]
    if (!dropZone || !taskCard) return;

    const newStatus = dropZone.getAttribute("data-status");
    const taskIdNum = taskId.replace("task-", "");
    try {
      const response = await fetch(`/api/tasks/${taskIdNum}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: newStatus }),
        credentials: "include"
      }); [cite: 30, 31]
      if (response.ok) dropZone.appendChild(taskCard); [cite: 32]
    } catch (error) { console.error("Update failed"); } [cite: 33]
  }
</script>