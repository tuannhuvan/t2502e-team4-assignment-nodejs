<% function getAge(dob) { const birth = new Date(dob); const today = new Date(); let age = today.getFullYear() - birth.getFullYear(); const monthDiff = today.getMonth() - birth.getMonth(); const dayDiff = today.getDate() - birth.getDate(); if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) { age--; } return age; } %>


<div class="page">

  <% if (landingMode) { %>
    <section class="landing-preview">
      <div class="landing-card">
        <h2>Discover TaskFlow</h2>
        <p>TaskFlow keeps your projects, tasks, and teams organized in one place. Sign in to open the full workspace.</p>

        <div class="landing-features">
          <div class="feature-item">
            <h3>Kanban board</h3>
            <p>See progress across todo, in progress, and done.</p>
          </div>
          <div class="feature-item">
            <h3>Project overview</h3>
            <p>Track active projects and team collaboration at a glance.</p>
          </div>
          <div class="feature-item">
            <h3>Task stats</h3>
            <p>Monitor totals, overdue work, and completed tasks.</p>
          </div>
        </div>

        <div class="landing-actions">
          <a href="/login" class="btn-primary">Login</a>
          <a href="/register" class="btn-secondary">Register</a>
        </div>
      </div>
    </section>
  <% } else { %>
    <div class="dashboard-topbar">
      <div class="page-toolbar">
        <div class="page-toolbar-left">
          <h2>Project dashboard</h2>
         
        </div>
        <% if (projects && projects.length > 0) { %>
          <div class="project-switcher">
            <label for="projectSelector">Current project</label>
            <select id="projectSelector" onchange="changeProject(this.value)">
              <option value="">Select project...</option>
              <% projects.forEach(project => { %>
                <option value="<%= project._id %>" <%= currentProject && currentProject._id?.toString() === project._id?.toString() ? "selected" : "" %>><%= project.name %></option>
              <% }) %>
            </select>
          </div>
        <% } %>
      </div>
    </div>
    <section class="project-overview">
      <div class="project-info-card">
        <% if (currentProject) { %>
          <div class="project-main-info">
            <div class="project-icon">📁</div>
            <div>
              <p class="project-label">Current Project</p>
              <h2><%= currentProject.name %></h2>
            </div>
            <span class="project-badge">Active</span>
          </div>
          <p class="project-description"><%= currentProject.description %></p>
        <% } else { %>
          <div class="project-main-info">
            <h2>No Project Selected</h2>
            <p>Please select a project from the list to view tasks.</p>
          </div>
        <% } %>
      </div>
    </section>

    <section class="stats">
      <div class="stat-card">
        <h3>Total Tasks</h3>
        <p><%= totalTasks %></p>
      </div>
      <div class="stat-card">
        <h3>Overdue</h3>
        <p><%= overdueTasks %></p>
      </div>
      <div class="stat-card">
        <h3>In Progress</h3>
        <p><%= inProgressTasks %></p>
      </div>
      <div class="stat-card">
        <h3>Done</h3>
        <p><%= doneTasks %></p>
      </div>
    </section>

    <div class="board-toolbar">
      <div>
        <h2 class="board-title">Task Board</h2>
        <p class="board-subtitle">Manage tasks by status and track project progress</p>
      </div>
    </div>

    <% 
      let canDragTasks = false;
      if (currentProjectMembers && userId) {
        const currentMember = currentProjectMembers.find(member => {
          const memberUserId = member.userId || member.user?._id;
          return memberUserId?.toString() === userId?.toString();
        });
        if (currentMember) {
          const permissionValue = currentMember.permission || 'view';
          const isOwner = currentMember.role === 'Owner';
          canDragTasks = isOwner || permissionValue === 'admin' || permissionValue === 'comment';
        }
      }
    %>
    <section class="board">
      <% statusCategories.forEach(status => { %>
        <div class="column drop-zone" data-status="<%= status.key %>" ondrop="dropTaskWithUpdate(event)" ondragover="allowDrop(event)">
          <h2><%= status.label %></h2>
          <% const tasksInColumn = activeTasks.filter(task => task.status === status.key); %>
          <% if (tasksInColumn.length === 0) { %>
            <div class="empty-column-message">No tasks yet.</div>
          <% } %>
          <% tasksInColumn.forEach(task => { %>
            <div class="task-card" id="task-<%= task.id %>" <%= canDragTasks ? 'draggable="true"' : '' %> ondragstart="dragTask(event)">
              <div class="task-card-top">
                <h4><%= task.title %></h4>
                <%
                  const priority = task.priority || 'low';
                %>
                <span class="priority <%= priority.toLowerCase() %>">
                  <%= priority %>
                </span>
              </div>
              <p class="task-description"><%= task.description %></p>
              <p>👤 <%= task.assigneeName %></p>
              <p>📅 <%= task.deadline %></p>
              <p>🧩 Project ID: <%= task.projectId %></p>
              <p>🕒 Updated: <%= task.updatedAt %></p>
              <a href="/task/<%= task.id %>" class="task-detail-link">View detail</a>
