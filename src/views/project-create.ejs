<div class="page">
  <p class="page-subtitle">Create a new project for your team</p>

  <section class="form-page">
    <div class="form-card">
      <div class="form-card-header">
        <div>
          <p class="project-label">Project Management</p>
          <h2>Create Project</h2>
        </div>
        <a href="/dashboard" class="back-link">← Back to dashboard</a>
      </div>

      <form class="task-form" id="createProjectForm">
        <div class="form-grid">
          <div class="form-group form-group-full">
            <label for="name">Project Name</label>
            <input type="text" id="name" name="name" placeholder="Enter project name" required>
          </div>

          <div class="form-group form-group-full">
            <label for="description">Project Description</label>
            <textarea id="description" name="description" placeholder="Describe the project" required></textarea>
          </div>
        </div>

        <p id="projectMessage" class="form-message"></p>

        <div class="form-actions">
          <a href="/dashboard" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary">Create Project</button>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
  const createProjectForm = document.getElementById("createProjectForm");
  const projectMessage = document.getElementById("projectMessage");

  createProjectForm.addEventListener("submit", async event => {
    event.preventDefault();

    const formData = {
      name: document.getElementById("name").value.trim(),
      description: document.getElementById("description").value.trim()
    };

    projectMessage.textContent = "Processing...";
    projectMessage.className = "form-message";

    try {
      const response = await fetch("/api/projects", {
        method: "POST",
        credentials: "include",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(formData)
      });

      const data = await response.json();

      if (!response.ok) {
        projectMessage.textContent = data.message || "Project creation failed";
        projectMessage.className = "form-message error-message";
        return;
      }

      projectMessage.textContent = data.message || "Project created successfully";
      projectMessage.className = "form-message success-message";
      setTimeout(() => {
        window.location.href = "/dashboard";
      }, 600);
    } catch (error) {
      projectMessage.textContent = "Cannot connect to server";
      projectMessage.className = "form-message error-message";
    }
  });
</script>
