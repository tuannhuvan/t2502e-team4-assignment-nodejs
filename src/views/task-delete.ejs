<div class="page">
  <div class="delete-card">
    <h2>Delete Task</h2>
    <div class="delete-warning-box">
      <h3>Bạn có chắc muốn xóa task: <strong><%= task.title %></strong>?</h3>
    </div>
    <div class="form-actions">
      <a href="/task/<%= task._id %>" class="btn-secondary">Hủy</a>
      <button type="button" class="btn-danger" id="confirmDeleteBtn">Xóa</button>
    </div>
  </div>
</div>

<script>
  document.getElementById("confirmDeleteBtn").addEventListener("click", async () => {
    try {
      const res = await fetch(`/api/tasks/${"<%= task._id %>"}`, {
        method: "DELETE",
        credentials: "include"
      });
      if (res.ok) {
        showToast("Xóa task thành công", "success");
        window.location.href = "/dashboard";
      } else {
        const data = await res.json();
        showToast(data.message || "Xóa thất bại", "error");
      }
    } catch (err) {
      showToast("Không thể kết nối máy chủ", "error");
    }
  });
</script>