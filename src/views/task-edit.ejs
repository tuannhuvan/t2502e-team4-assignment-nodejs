<div class="page">
  <p class="page-subtitle">Update task information and keep project progress accurate</p>

  <section class="form-page">
    <div class="form-card">
      <div class="form-card-header">
        <div>
          <p class="project-label">Task Management</p>
          <h2>Edit Task</h2>
        </div>
        <a href="/task/<%= task.id %>" class="back-link">← Back to task detail</a>
      </div>

      <form class="task-form" id="editTaskForm">
        <div class="form-grid">
          <div class="form-group">
            <label for="title">Task Title</label>
            <input type="text" id="title" name="title" value="<%= task.title %>" required>
          </div>

          <div class="form-group">
            <label for="projectId">Project</label>
            <select id="projectId" name="projectId" required>
              <% projects.forEach(project => { %>
                <option value="<%= project.id %>" <%= project.id === task.projectId ? "selected" : "" %>>
                  <%= project.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group form-group-full">
            <label for="description">Description</label>
            <textarea id="description" name="description" required><%= task.description %></textarea>
          </div>

          <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status" required>
              <option value="todo"        <%= task.status === "todo"        ? "selected" : "" %>>To Do</option>
              <option value="in_progress" <%= task.status === "in_progress" ? "selected" : "" %>>In Progress</option>
              <option value="done"        <%= task.status === "done"        ? "selected" : "" %>>Done</option>
            </select>
          </div>

          <div class="form-group">
            <label for="priority">Priority</label>
            <select id="priority" name="priority" required>
              <option value="low"    <%= task.priority === "low"    ? "selected" : "" %>>Low</option>
              <option value="medium" <%= task.priority === "medium" ? "selected" : "" %>>Medium</option>
              <option value="high"   <%= task.priority === "high"   ? "selected" : "" %>>High</option>
            </select>
          </div>

          <div class="form-group">
            <label for="assigneeId">Assignee</label>
            <select id="assigneeId" name="assigneeId" required>
              <% users.forEach(user => { %>
                <option value="<%= user.id %>" <%= user.id === task.assigneeId ? "selected" : "" %>>
                  <%= user.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="form-group">
            <label for="deadline">Deadline</label>
            <input type="date" id="deadline" name="deadline" value="<%= task.deadline %>" required>
          </div>
        </div>

        <p id="editMessage" class="form-message"></p>

        <div class="form-actions">
          <a href="/task/<%= task.id %>" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary">Update Task</button>
        </div>
      </form>
    </div>
  </section>
</div>

<script>
  const editTaskForm = document.getElementById("editTaskForm");
  const editMessage  = document.getElementById("editMessage");

  editTaskForm.addEventListener("submit", async event => {
    event.preventDefault();

    const formData = {
      title:      document.getElementById("title").value.trim(),
      projectId:  document.getElementById("projectId").value,
      description:document.getElementById("description").value.trim(),
      status:     document.getElementById("status").value,
      priority:   document.getElementById("priority").value,
      assigneeId: document.getElementById("assigneeId").value,
      deadline:   document.getElementById("deadline").value
    };

    editMessage.textContent = "Processing...";
    editMessage.className   = "form-message";

    try {
      const response = await fetch("/api/tasks/<%= task.id %>", {
        method:  "PUT",
        headers: { "Content-Type": "application/json" },
        body:    JSON.stringify(formData)
      });

      const data = await response.json();

      if (!response.ok) {
        editMessage.textContent = data.message || "Update failed";
        editMessage.className   = "form-message error-message";
        return;
      }

      editMessage.textContent = data.message || "Task updated successfully";
      editMessage.className   = "form-message success-message";
    } catch (error) {
      editMessage.textContent = "Cannot connect to server";
      editMessage.className   = "form-message error-message";
    }
  });
</script>
