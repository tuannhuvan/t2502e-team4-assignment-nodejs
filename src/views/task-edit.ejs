<div class="page">
  <h2>Edit Task</h2>
  <form id="editTaskForm">
    <input type="text" id="title" value="<%= task.title %>" required>
    <select id="projectId">
      <% projects.forEach(p => { %>
        <option value="<%= p._id %>" <%= p._id.toString() === task.projectId.toString() ? 'selected' : '' %>>
          <%= p.name %>
        </option>
      <% }) %>
    </select>
    <textarea id="description" required><%= task.description %></textarea>
    <select id="status">
      <option value="todo" <%= task.status === 'todo' ? 'selected' : '' %>>To Do</option>
      <option value="in_progress" <%= task.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
      <option value="done" <%= task.status === 'done' ? 'selected' : '' %>>Done</option>
    </select>
    <input type="date" id="deadline" value="<%= task.deadline ? new Date(task.deadline).toISOString().split('T')[0] : '' %>">
    <button type="submit" class="btn-primary">Update Task</button>
  </form>
</div>

<script>
  document.getElementById("editTaskForm").addEventListener("submit", async e => {
    e.preventDefault();
    const data = {
      title: document.getElementById("title").value,
      projectId: document.getElementById("projectId").value,
      description: document.getElementById("description").value,
      status: document.getElementById("status").value,
      deadline: document.getElementById("deadline").value
    };
    try {
      const res = await fetch(`/api/tasks/${"<%= task._id %>"}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
        credentials: "include"
      });
      if (res.ok) {
        showToast("Cập nhật task thành công", "success");
        window.location.href = "/dashboard";
      } else {
        const data = await res.json();
        showToast(data.message || "Cập nhật thất bại", "error");
      }
    } catch (err) {
      showToast("Không thể kết nối máy chủ", "error");
    }
  });
</script>