<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Task Detail</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">
    <header class="topbar">
      <h1>📌 Task Detail</h1>
      <p>View task information and comments</p>
    </header>

    <div class="detail-layout">
      <section class="task-detail-card">
        <div class="detail-header">
          <h2>Build dashboard UI</h2>
          <span class="priority medium">Medium</span>
        </div>

        <div class="detail-info">
          <p><strong>Status:</strong> In Progress</p>
          <p><strong>Assignee:</strong> Team 4</p>
          <p><strong>Deadline:</strong> 2026-04-12</p>
          <p><strong>Project:</strong> TaskFlow</p>
        </div>

        <div class="detail-description">
          <h3>Description</h3>
          <p>
            Build the dashboard interface for the TaskFlow project, including
            summary cards, kanban columns, and task cards layout.
          </p>
        </div>
      </section>

      <section class="comment-section">
        <h3>Comments</h3>

        <div class="comment-list">
          <div class="comment-item">
            <p class="comment-author">Tuan</p>
            <p class="comment-text">Please update the overdue card color.</p>
          </div>

          <div class="comment-item">
            <p class="comment-author">Tung</p>
            <p class="comment-text">I will finish the UI layout today.</p>
          </div>
        </div>

        <form class="comment-form">
          <textarea placeholder="Write a comment..."></textarea>
          <button type="submit">Add Comment</button>
        </form>
      </section>
    </div>
  </div>
</body>
</html>
