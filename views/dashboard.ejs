<%
  function getAge(dob) {
    const birth = new Date(dob);
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const monthDiff = today.getMonth() - birth.getMonth();
    const dayDiff = today.getDate() - birth.getDate();

    if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) {
      age--;
    }

    return age;
  }
%>

    <!DOCTYPE html>
    <html lang="en">

    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>TaskFlow Dashboard</title>
      <link rel="stylesheet" href="/style.css">
    </head>

    <script>
      function allowDrop(event) {
        event.preventDefault();
      }

      function dragTask(event) {
        event.dataTransfer.setData("text/plain", event.currentTarget.id);
      }

      function dropTask(event) {
        event.preventDefault();

        const taskId = event.dataTransfer.getData("text/plain");
        const taskCard = document.getElementById(taskId);

        let dropZone = event.target;
        while (dropZone && !dropZone.classList.contains("drop-zone")) {
          dropZone = dropZone.parentElement;
        }

        if (!dropZone || !taskCard) {
          return;
        }

        dropZone.appendChild(taskCard);
      }
    </script>

    <body>
      <div class="page">
        <%- include('partials/header') %>
          <p class="page-subtitle">Project Dashboard + Kanban Board</p>

          <section class="project-overview">
            <div class="project-summary-card">
              <div class="project-summary-top">
                <div>
                  <p class="project-label">Current Project</p>
                  <h2>
                    <%= currentProject.name %>
                  </h2>
                </div>
                <span class="project-badge">Active</span>
              </div>

              <p class="project-description">
                <%= currentProject.description %>
              </p>

              <div class="project-meta-grid">
                <div class="project-meta-item">
                  <span class="meta-title">Owner</span>
                  <strong>
                    <%= currentProject.ownerName %>
                  </strong>
                </div>

                <div class="project-meta-item">
                  <span class="meta-title">Members</span>
                  <strong>
                    <%= currentProject.memberCount %>
                  </strong>
                </div>

                <div class="project-meta-item">
                  <span class="meta-title">Created At</span>
                  <strong>
                    <%= currentProject.createdAt %>
                  </strong>
                </div>

                <div class="project-meta-item">
                  <span class="meta-title">Updated At</span>
                  <strong>
                    <%= currentProject.updatedAt %>
                  </strong>
                </div>
              </div>
            </div>
          </section>

          <section class="team">
            <h2>👥 Project Members</h2>

            <div class="team-list">
              <% currentProjectMembers.forEach(member=> { %>
                <div class="team-card <%= member.role === 'Owner' ? 'leader-card' : '' %>">
                  <div class="member-header">
                    <img src="<%= member.avatar %>" alt="<%= member.name %>" class="member-avatar">
                    <h3>
                      <%= member.name %>
                    </h3>
                  </div>

                  <p><strong>Project Role:</strong>
                    <%= member.role %>
                  </p>
                  <p><strong>GitHub:</strong>
                    <%= member.github %>
                  </p>
                  <p><strong>DOB:</strong>
                    <%= member.dob %>
                  </p>
                  <p><strong>Age:</strong>
                    <%= getAge(member.dob) %>
                  </p>
                  <p><strong>User ID:</strong>
                    <%= member.userId %>
                  </p>
                </div>
                <% }) %>
            </div>
          </section>

          <section class="stats">
            <div class="stat-card">
              <h3>Total Tasks</h3>
              <p>
                <%= totalTasks %>
              </p>
            </div>

            <div class="stat-card">
              <h3>Overdue</h3>
              <p>
                <%= overdueTasks %>
              </p>
            </div>

            <div class="stat-card">
              <h3>In Progress</h3>
              <p>
                <%= inProgressTasks %>
              </p>
            </div>

            <div class="stat-card">
              <h3>Done</h3>
              <p>
                <%= doneTasks %>
              </p>
            </div>
          </section>

          <div class="board-toolbar">
            <div>
              <h2 class="board-title">Task Board</h2>
              <p class="board-subtitle">Manage tasks by status and track project progress</p>
            </div>

          </div>

          <section class="board">
            <div class="column drop-zone" data-status="todo" ondrop="dropTask(event)" ondragover="allowDrop(event)">
              <h2>To Do</h2>

              <% activeTasks.filter(task=> task.status === "todo").forEach(task => { %>
                <div class="task-card" id="task-<%= task.id %>" draggable="true" ondragstart="dragTask(event)">
                  <div class="task-card-top">
                    <h4>
                      <%= task.title %>
                    </h4>
                    <span class="priority <%= task.priority.toLowerCase() %>">
                      <%= task.priority %>
                    </span>
                  </div>

                  <p class="task-description">
                    <%= task.description %>
                  </p>
                  <p>👤 <%= task.assigneeName %>
                  </p>
                  <p>📅 <%= task.deadline %>
                  </p>
                  <p>🧩 Project ID: <%= task.projectId %>
                  </p>
                  <p>🕒 Updated: <%= task.updatedAt %>
                  </p>

                  <a href="/task/<%= task.id %>" class="task-detail-link">View detail</a>
                </div>
                <% }) %>
            </div>

            <div class="column drop-zone" data-status="in_progress" ondrop="dropTask(event)"
              ondragover="allowDrop(event)">
              <h2>In Progress</h2>

              <% activeTasks.filter(task=> task.status === "in_progress").forEach(task => { %>
                <div class="task-card" id="task-<%= task.id %>" draggable="true" ondragstart="dragTask(event)">
                  <div class="task-card-top">
                    <h4>
                      <%= task.title %>
                    </h4>
                    <span class="priority <%= task.priority.toLowerCase() %>">
                      <%= task.priority %>
                    </span>
                  </div>

                  <p class="task-description">
                    <%= task.description %>
                  </p>
                  <p>👤 <%= task.assigneeName %>
                  </p>
                  <p>📅 <%= task.deadline %>
                  </p>
                  <p>🧩 Project ID: <%= task.projectId %>
                  </p>
                  <p>🕒 Updated: <%= task.updatedAt %>
                  </p>

                  <a href="/task/<%= task.id %>" class="task-detail-link">View detail</a>
                </div>
                <% }) %>
            </div>

            <div class="column drop-zone" data-status="done" ondrop="dropTask(event)" ondragover="allowDrop(event)">
              <h2>Done</h2>

              <% activeTasks.filter(task=> task.status === "done").forEach(task => { %>
                <div class="task-card" id="task-<%= task.id %>" draggable="true" ondragstart="dragTask(event)">
                  <div class="task-card-top">
                    <h4>
                      <%= task.title %>
                    </h4>
                    <span class="priority <%= task.priority.toLowerCase() %>">
                      <%= task.priority %>
                    </span>
                  </div>

                  <p class="task-description">
                    <%= task.description %>
                  </p>
                  <p>👤 <%= task.assigneeName %>
                  </p>
                  <p>📅 <%= task.deadline %>
                  </p>
                  <p>🧩 Project ID: <%= task.projectId %>
                  </p>
                  <p>🕒 Updated: <%= task.updatedAt %>
                  </p>

                  <a href="/task/<%= task.id %>" class="task-detail-link">View detail</a>
                </div>
                <% }) %>
            </div>
          </section>


      </div>
    </body>

    </html>