<%
  const members = [
    {
      name: "Nhữ Văn Tuấn",
      role: "Leader",
      github: "tuannhuvan",
      dob: "2000-01-15"
    },
    {
      name: "Nguyễn Hữu Trí",
      role: "Member",
      github: "Ooloobooloo",
      dob: "2000-08-10"
    },
    {
      name: "Nguyễn Văn Linh",
      role: "Member",
      github: "nhoi03",
      dob: "2004-03-23"
    },
    {
      name: "Nguyễn Xuân Tùng",
      role: "Member",
      github: "XuanTung2493",
      dob: "2000-05-12"
    }
  ];

  function getAge(dob) {
    const birth = new Date(dob);
    const today = new Date();
    let age = today.getFullYear() - birth.getFullYear();
    const monthDiff = today.getMonth() - birth.getMonth();
    const dayDiff = today.getDate() - birth.getDate();

    if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) {
      age--;
    }

    return age;
  }

  const tasks = [
    {
      id: 1,
      title: "Design login page",
      assignee: "Nguyễn Xuân Tùng",
      deadline: "2026-04-10",
      priority: "High",
      status: "todo"
    },
    {
      id: 2,
      title: "Build dashboard UI",
      assignee: "Nhữ Văn Tuấn",
      deadline: "2026-04-12",
      priority: "Medium",
      status: "inprogress"
    },
    {
      id: 3,
      title: "Create task detail page",
      assignee: "Nguyễn Hữu Trí",
      deadline: "2026-04-11",
      priority: "High",
      status: "inprogress"
    },
    {
      id: 4,
      title: "Setup project structure",
      assignee: "Nguyễn Văn Linh",
      deadline: "2026-04-08",
      priority: "Low",
      status: "done"
    },
    {
      id: 5,
      title: "Style kanban board",
      assignee: "Nguyễn Xuân Tùng",
      deadline: "2026-04-13",
      priority: "Medium",
      status: "todo"
    },
    {
      id: 6,
      title: "Prepare comment section UI",
      assignee: "Nguyễn Văn Linh",
      deadline: "2026-04-14",
      priority: "Low",
      status: "done"
    }
  ];

  const totalTasks = tasks.length;
  const overdueTasks = tasks.filter(task => new Date(task.deadline) < new Date()).length;
  const inProgressTasks = tasks.filter(task => task.status === "inprogress").length;
  const doneTasks = tasks.filter(task => task.status === "done").length;
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TaskFlow Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">

    <%- include('partials/header') %>
    <p class="page-subtitle">Dashboard + Kanban Board</p>

    <section class="team">
      <h2>👥 Team Members</h2>

      <div class="team-list">
        <% members.forEach(member => { %>
          <div class="team-card <%= member.role === 'Leader' ? 'leader-card' : '' %>">
            <h3><%= member.name %></h3>
            <p><strong>Role:</strong> <%= member.role %></p>
            <p><strong>GitHub:</strong> <%= member.github %></p>
            <p><strong>DOB:</strong> <%= member.dob %></p>
            <p><strong>Age:</strong> <%= getAge(member.dob) %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="stats">
      <div class="stat-card">
        <h3>Total Tasks</h3>
        <p><%= totalTasks %></p>
      </div>

      <div class="stat-card">
        <h3>Overdue</h3>
        <p><%= overdueTasks %></p>
      </div>

      <div class="stat-card">
        <h3>In Progress</h3>
        <p><%= inProgressTasks %></p>
      </div>

      <div class="stat-card">
        <h3>Done</h3>
        <p><%= doneTasks %></p>
      </div>
    </section>

    <section class="board">
      <div class="column">
        <h2>To Do</h2>

        <% tasks.filter(task => task.status === "todo").forEach(task => { %>
          <a href="/task-detail" class="task-link">
            <div class="task-card">
              <h4><%= task.title %></h4>
              <p>👤 <%= task.assignee %></p>
              <p>📅 <%= task.deadline %></p>
              <span class="priority <%= task.priority.toLowerCase() %>"><%= task.priority %></span>
            </div>
          </a>
        <% }) %>
      </div>

      <div class="column">
        <h2>In Progress</h2>

        <% tasks.filter(task => task.status === "inprogress").forEach(task => { %>
          <a href="/task-detail" class="task-link">
            <div class="task-card">
              <h4><%= task.title %></h4>
              <p>👤 <%= task.assignee %></p>
              <p>📅 <%= task.deadline %></p>
              <span class="priority <%= task.priority.toLowerCase() %>"><%= task.priority %></span>
            </div>
          </a>
        <% }) %>
      </div>

      <div class="column">
        <h2>Done</h2>

        <% tasks.filter(task => task.status === "done").forEach(task => { %>
          <a href="/task-detail" class="task-link">
            <div class="task-card">
              <h4><%= task.title %></h4>
              <p>👤 <%= task.assignee %></p>
              <p>📅 <%= task.deadline %></p>
              <span class="priority <%= task.priority.toLowerCase() %>"><%= task.priority %></span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>

  </div>
</body>
</html>