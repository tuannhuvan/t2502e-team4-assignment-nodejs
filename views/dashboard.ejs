<% const projects=[ { id: 1, name: "TaskFlow - Mini Trello" ,
  description: "Team assignment for NodeJS + Express + MongoDB with realtime updates." , ownerId: 1, isDeleted: false,
  createdAt: "2026-04-01 08:00" , updatedAt: "2026-04-09 09:30" } ]; const users=[ { id: 1, name: "Nhữ Văn Tuấn" ,
  github: "tuannhuvan" , dob: "2000-01-15" , avatar: "/images/tuan.jpg" }, { id: 2, name: "Nguyễn Hữu Trí" ,
  github: "Ooloobooloo" , dob: "2000-08-10" , avatar: "/images/tri.jpg" }, { id: 3, name: "Nguyễn Văn Linh" ,
  github: "nhoi03" , dob: "2004-03-23" , avatar: "/images/linh.jpg" }, { id: 4, name: "Nguyễn Xuân Tùng" ,
  github: "XuanTung2493" , dob: "2000-05-12" , avatar: "/images/tung.jpg" } ]; const projectMembers=[ { id: 1,
  projectId: 1, userId: 1, role: "Owner" }, { id: 2, projectId: 1, userId: 2, role: "Member" }, { id: 3, projectId: 1,
  userId: 3, role: "Member" }, { id: 4, projectId: 1, userId: 4, role: "Member" } ]; const tasks=[ { id: 1, projectId:
  1, title: "Collect requirements" , description: "Review assignment scope, ERD and task distribution for the team." ,
  status: "todo" , priority: "high" , assigneeId: 1, createdBy: 1, deadline: "2026-04-10" , isDeleted: false,
  createdAt: "2026-04-05 09:00" , updatedAt: "2026-04-06 11:15" }, { id: 2, projectId: 1, title: "Design dashboard UI" ,
  description: "Build personal dashboard, stats cards and kanban layout with EJS." , status: "in_progress" ,
  priority: "medium" , assigneeId: 4, createdBy: 1, deadline: "2026-04-12" , isDeleted: false,
  createdAt: "2026-04-05 10:00" , updatedAt: "2026-04-08 14:20" }, { id: 3, projectId: 1,
  title: "Create task detail page" , description: "Prepare task detail UI with task information and comment section." ,
  status: "in_progress" , priority: "high" , assigneeId: 2, createdBy: 1, deadline: "2026-04-11" , isDeleted: false,
  createdAt: "2026-04-05 10:30" , updatedAt: "2026-04-09 08:45" }, { id: 4, projectId: 1,
  title: "Setup project structure" , description: "Organize views, partials, public assets and initial routing." ,
  status: "done" , priority: "low" , assigneeId: 3, createdBy: 1, deadline: "2026-04-08" , isDeleted: false,
  createdAt: "2026-04-04 13:00" , updatedAt: "2026-04-07 16:10" }, { id: 5, projectId: 1, title: "Style auth pages" ,
  description: "Polish login/register screens and align them with dashboard design." , status: "todo" ,
  priority: "medium" , assigneeId: 4, createdBy: 1, deadline: "2026-04-13" , isDeleted: false,
  createdAt: "2026-04-06 09:20" , updatedAt: "2026-04-08 17:00" }, { id: 6, projectId: 1,
  title: "Prepare comment section UI" ,
  description: "Display comments and add input form for future backend integration." , status: "done" , priority: "low"
  , assigneeId: 3, createdBy: 1, deadline: "2026-04-14" , isDeleted: false, createdAt: "2026-04-06 15:40" ,
  updatedAt: "2026-04-09 09:10" } ]; function getAge(dob) { const birth=new Date(dob); const today=new Date(); let
  age=today.getFullYear() - birth.getFullYear(); const monthDiff=today.getMonth() - birth.getMonth(); const
  dayDiff=today.getDate() - birth.getDate(); if (monthDiff < 0 || (monthDiff===0 && dayDiff < 0)) { age--; } return age;
  } function getUserById(userId) { return users.find(user=> user.id === userId);
  }

  const currentProject = projects[0];
  const owner = getUserById(currentProject.ownerId);

  const currentProjectMembers = projectMembers
  .filter(member => member.projectId === currentProject.id)
  .map(member => {
  const user = getUserById(member.userId);
  return {
  ...member,
  ...user
  };
  });

  const activeTasks = tasks.filter(task => !task.isDeleted);
  const totalTasks = activeTasks.length;
  const overdueTasks = activeTasks.filter(task => new Date(task.deadline) < new Date()).length; const
    inProgressTasks=activeTasks.filter(task=> task.status === "in_progress").length;
    const doneTasks = activeTasks.filter(task => task.status === "done").length;
    %>

    <!DOCTYPE html>
    <html lang="en">

    <head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>TaskFlow Dashboard</title>
      <link rel="stylesheet" href="/style.css">
    </head>

    <body>
      <div class="page">
        <%- include('partials/header') %>
          <p class="page-subtitle">Project Dashboard + Kanban Board</p>

          <section class="project-overview">
            <div class="project-summary-card">
              <div class="project-summary-top">
                <div>
                  <p class="project-label">Current Project</p>
                  <h2>
                    <%= currentProject.name %>
                  </h2>
                </div>
                <span class="project-badge">Active</span>
              </div>

              <p class="project-description">
                <%= currentProject.description %>
              </p>

              <div class="project-meta-grid">
                <div class="project-meta-item">
                  <span class="meta-title">Owner</span>
                  <strong>
                    <%= owner.name %>
                  </strong>
                </div>

                <div class="project-meta-item">
                  <span class="meta-title">Members</span>
                  <strong>
                    <%= currentProjectMembers.length %>
                  </strong>
                </div>

                <div class="project-meta-item">
                  <span class="meta-title">Created At</span>
                  <strong>
                    <%= currentProject.createdAt %>
                  </strong>
                </div>

                <div class="project-meta-item">
                  <span class="meta-title">Updated At</span>
                  <strong>
                    <%= currentProject.updatedAt %>
                  </strong>
                </div>
              </div>
            </div>
          </section>

          <section class="team">
            <h2>👥 Project Members</h2>

            <div class="team-list">
              <% currentProjectMembers.forEach(member=> { %>
                <div class="team-card <%= member.role === 'Owner' ? 'leader-card' : '' %>">
                  <div class="member-header">
                    <img src="<%= member.avatar %>" alt="<%= member.name %>" class="member-avatar">
                    <h3>
                      <%= member.name %>
                    </h3>
                  </div>

                  <p><strong>Project Role:</strong>
                    <%= member.role %>
                  </p>
                  <p><strong>GitHub:</strong>
                    <%= member.github %>
                  </p>
                  <p><strong>DOB:</strong>
                    <%= member.dob %>
                  </p>
                  <p><strong>Age:</strong>
                    <%= getAge(member.dob) %>
                  </p>
                  <p><strong>User ID:</strong>
                    <%= member.userId %>
                  </p>
                </div>
                <% }) %>
            </div>
          </section>

          <section class="stats">
            <div class="stat-card">
              <h3>Total Tasks</h3>
              <p>
                <%= totalTasks %>
              </p>
            </div>

            <div class="stat-card">
              <h3>Overdue</h3>
              <p>
                <%= overdueTasks %>
              </p>
            </div>

            <div class="stat-card">
              <h3>In Progress</h3>
              <p>
                <%= inProgressTasks %>
              </p>
            </div>

            <div class="stat-card">
              <h3>Done</h3>
              <p>
                <%= doneTasks %>
              </p>
            </div>
          </section>

          <div class="board-toolbar">
            <div>
              <h2 class="board-title">Task Board</h2>
              <p class="board-subtitle">Manage tasks by status and track project progress</p>
            </div>

            <a href="/task/create" class="btn-primary">+ Create Task</a>
          </div>

          <section class="board">
            <div class="column">
              <h2>To Do</h2>

              <% activeTasks.filter(task=> task.status === "todo").forEach(task => { %>
                <div class="task-card">
                  <div class="task-card-top">
                    <h4>
                      <%= task.title %>
                    </h4>
                    <span class="priority <%= task.priority.toLowerCase() %>">
                      <%= task.priority %>
                    </span>
                  </div>

                  <p class="task-description">
                    <%= task.description %>
                  </p>
                  <p>👤 <%= getUserById(task.assigneeId).name %>
                  </p>
                  <p>📅 <%= task.deadline %>
                  </p>
                  <p>🧩 Project ID: <%= task.projectId %>
                  </p>
                  <p>🕒 Updated: <%= task.updatedAt %>
                  </p>

                  <a href="/task/<%= task.id %>" class="task-detail-link">View detail</a>
                </div>
                <% }) %>
            </div>

            <div class="column">
              <h2>In Progress</h2>

              <% activeTasks.filter(task=> task.status === "in_progress").forEach(task => { %>
                <div class="task-card">
                  <div class="task-card-top">
                    <h4>
                      <%= task.title %>
                    </h4>
                    <span class="priority <%= task.priority.toLowerCase() %>">
                      <%= task.priority %>
                    </span>
                  </div>

                  <p class="task-description">
                    <%= task.description %>
                  </p>
                  <p>👤 <%= getUserById(task.assigneeId).name %>
                  </p>
                  <p>📅 <%= task.deadline %>
                  </p>
                  <p>🧩 Project ID: <%= task.projectId %>
                  </p>
                  <p>🕒 Updated: <%= task.updatedAt %>
                  </p>

                  <a href="/task/<%= task.id %>" class="task-detail-link">View detail</a>
                </div>
                <% }) %>
            </div>

            <div class="column">
              <h2>Done</h2>

              <% activeTasks.filter(task=> task.status === "done").forEach(task => { %>
                <div class="task-card">
                  <div class="task-card-top">
                    <h4>
                      <%= task.title %>
                    </h4>
                    <span class="priority <%= task.priority.toLowerCase() %>">
                      <%= task.priority %>
                    </span>
                  </div>

                  <p class="task-description">
                    <%= task.description %>
                  </p>
                  <p>👤 <%= getUserById(task.assigneeId).name %>
                  </p>
                  <p>📅 <%= task.deadline %>
                  </p>
                  <p>🧩 Project ID: <%= task.projectId %>
                  </p>
                  <p>🕒 Updated: <%= task.updatedAt %>
                  </p>

                  <a href="/task/<%= task.id %>" class="task-detail-link">View detail</a>
                </div>
                <% }) %>
            </div>
          </section>


      </div>
    </body>

    </html>