<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>TaskFlow Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="page">

    <header class="topbar">
      <h1>🚀 TaskFlow</h1>
      <p>Dashboard + Kanban Board</p>
    </header>

    <!-- DASHBOARD -->
    <section class="stats">
      <div class="stat-card">
        <h3>Total Tasks</h3>
        <p>12</p>
      </div>

      <div class="stat-card">
        <h3>Overdue</h3>
        <p>3</p>
      </div>

      <div class="stat-card">
        <h3>In Progress</h3>
        <p>4</p>
      </div>

      <div class="stat-card">
        <h3>Done</h3>
        <p>5</p>
      </div>
    </section>

    <!-- KANBAN -->
    <section class="board">

      <div class="column">
        <h2>To Do</h2>

        <div class="task-card">
          <h4>Design login page</h4>
          <p>👤 Tung</p>
          <p>📅 2026-04-10</p>
          <span class="priority high">High</span>
        </div>

      </div>

      <div class="column">
        <h2>In Progress</h2>

        <div class="task-card">
          <h4>Build dashboard UI</h4>
          <p>👤 Team 4</p>
          <p>📅 2026-04-12</p>
          <span class="priority medium">Medium</span>
        </div>

      </div>

      <div class="column">
        <h2>Done</h2>

        <div class="task-card">
          <h4>Setup project</h4>
          <p>👤 Team</p>
          <p>📅 2026-04-08</p>
          <span class="priority low">Low</span>
        </div>

      </div>

    </section>

  </div>

</body>
</html>