<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delete Task - TaskFlow</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">
    <%- include('partials/header') %>
    <p class="page-subtitle">Confirm task deletion before removing it from the project</p>

    <section class="form-page">
      <div class="delete-card">
        <div class="delete-header">
          <div>
            <p class="project-label">Task Management</p>
            <h2>Delete Task</h2>
          </div>
          <a href="/task/<%= task.id %>" class="back-link">← Back to task detail</a>
        </div>

        <div class="delete-warning-box">
          <h3>Are you sure you want to delete this task?</h3>
          <p>This action may remove the task from the current project workflow.</p>
        </div>

        <div class="delete-task-preview">
          <p><strong>Task ID:</strong> <%= task.id %></p>
          <p><strong>Title:</strong> <%= task.title %></p>
          <p><strong>Description:</strong> <%= task.description %></p>
          <p><strong>Status:</strong> <%= task.status %></p>
          <p><strong>Priority:</strong> <%= task.priority %></p>
          <p><strong>Deadline:</strong> <%= task.deadline %></p>
        </div>

        <div class="form-actions">
          <a href="/task/<%= task.id %>" class="btn-secondary">Cancel</a>
          <button type="button" class="btn-danger">Delete Task</button>
        </div>
      </div>
    </section>
  </div>
</body>
</html>